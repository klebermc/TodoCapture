# Copy to ~/.config/todo-capture/.env (or ./.env) and fill in. Never commit the real file.

# Notion internal integration secret (https://www.notion.so/my-integrations);
# the integration must be added to the database under ··· → Connections.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 32-char ID from the database URL: notion.so/<THIS_PART>?v=...
NOTION_DATABASE_ID=00000000000000000000000000000000

# Only needed for `todo -b` (Claude breakdown).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Optional: how ambiguous dates like 3/10 are read (MDY, DMY or YMD). Default MDY.
# TODO_DATE_ORDER=MDY
